<UserControl x:Class="StorageCleaner.App.Views.SafeCleanupView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:StorageCleaner.App.Models"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl"
                    Key="R"
                    Command="{Binding AnalyzeCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"
                    Key="A"
                    Command="{Binding SelectAllSafeCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock FontSize="22"
                           FontWeight="SemiBold"
                           Text="Safe Cleanup" />
                <TextBlock Margin="0,4,0,12"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="Preview candidates before deleting. Recycle Bin is used by default." />

                <Border Margin="0,0,0,12"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <CheckBox IsChecked="{Binding StrictSafetyMode, Mode=TwoWay}">
                            <TextBlock FontWeight="SemiBold"
                                       Text="Strict safety mode (recommended)" />
                        </CheckBox>
                        <TextBlock Margin="24,4,0,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="When enabled, project/workspace paths and other high-risk items are deselected and blocked unless you deliberately disable this mode." />
                    </StackPanel>
                </Border>

                <ItemsControl ItemsSource="{Binding Categories}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Margin="0,0,0,8"
                                    Padding="8"
                                    Background="{DynamicResource ElevatedSurfaceBrush}"
                                    BorderBrush="{DynamicResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8">
                                <StackPanel>
                                    <CheckBox IsChecked="{Binding IsSelected, Mode=TwoWay}">
                                        <TextBlock FontWeight="SemiBold"
                                                   Text="{Binding Title}" />
                                    </CheckBox>
                                    <TextBlock Margin="24,4,0,0"
                                               Foreground="{DynamicResource SubtleTextBrush}"
                                               Text="{Binding Description}" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <Grid Margin="0,6,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="170" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Height="34"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" />
                    <ComboBox Grid.Column="1"
                              Height="34"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding RecommendationFilters}"
                              SelectedItem="{Binding SelectedRecommendationFilter, Mode=TwoWay}" />
                    <TextBox Grid.Column="2"
                             Height="34"
                             ToolTip="Filter by name, path, or risk reason"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>

                <WrapPanel Margin="0,8,0,0">
                    <Button Margin="0,0,8,0"
                            Command="{Binding AnalyzeCommand}"
                            Content="Preview Cleanup" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SimulateSelectedCommand}"
                            Content="Simulate Selected" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SelectAllSafeCommand}"
                            Content="Select Safe" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SelectAllCommand}"
                            Content="Select All" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SelectNoneCommand}"
                            Content="Select None" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding UnlockRiskyCleanupForSessionCommand}"
                            ToolTip="Unlocks risky cleanup for this session only."
                            Content="Unlock Risky Cleanup (Session)" />
                    <Button Command="{Binding CleanSelectedCommand}"
                            ToolTip="Moves selected items to Recycle Bin after confirmation and backup."
                            Content="Clean Selected" />
                </WrapPanel>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,0,16,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding EstimatedBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Estimated: {0}}" />
                    <TextBlock Margin="0,0,16,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SelectedItemCount, StringFormat=Selected items: {0:N0}}" />
                    <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SelectedBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Selected: {0}}" />
                    <TextBlock Margin="16,0,0,0"
                               Foreground="{DynamicResource DangerBrush}"
                               Text="{Binding SelectedRiskyCount, StringFormat=Needs override: {0:N0}}" />
                </WrapPanel>
                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding StatusText}" />
                <TextBlock Margin="0,4,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding SimulationSummary}" />

                <Border Margin="0,8,0,0"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSuccessBanner}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SuccessBannerText}" />
                </Border>

                <Border Margin="0,8,0,0"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowUndoBanner}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding UndoBannerText}" />
                        <Button DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Command="{Binding DataContext.NavigateToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{x:Static models:NavigationSection.AdvancedTools}"
                                Content="Open Restore Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>
                <DataGrid Grid.Row="0"
                          AutoGenerateColumns="False"
                          ItemsSource="{Binding FilteredCandidates}"
                          SelectedItem="{Binding SelectedCandidate, Mode=TwoWay}">
                    <DataGrid.Columns>
                        <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay}"
                                                Header="Select"
                                                Width="70" />
                        <DataGridTextColumn Binding="{Binding SafetyRecommendation, Mode=OneWay}"
                                            Header="Recommendation"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding SafetyScore, Mode=OneWay}"
                                            Header="Safety"
                                            Width="80" />
                        <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                            Header="Category"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}"
                                            Header="Name"
                                            Width="200" />
                        <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                            Header="Path"
                                            Width="2*" />
                        <DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                            Header="Size"
                                            Width="110" />
                        <DataGridTextColumn Binding="{Binding RiskLabel, Mode=OneWay}"
                                            Header="Risk"
                                            Width="90" />
                        <DataGridTextColumn Binding="{Binding RiskReason, Mode=OneWay}"
                                            Header="Risk Reason"
                                            Width="2*" />
                        <DataGridTextColumn Binding="{Binding LastModifiedUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                            Header="Modified"
                                            Width="140" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Grid.Row="0"
                        Padding="14"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEmptyState}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding EmptyStateText}" />
                </Border>
                <Border Grid.Row="1"
                        Margin="0,10,0,0"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <StackPanel>
                        <TextBlock FontWeight="SemiBold"
                                   Text="Why This Is Safe" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding SafetyExplanation}"
                                   TextWrapping="Wrap" />
                    </StackPanel>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
