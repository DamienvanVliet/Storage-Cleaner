<UserControl x:Class="StorageCleaner.App.Views.AdvancedToolsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <ScrollViewer VerticalScrollBarVisibility="Auto"
                  HorizontalScrollBarVisibility="Disabled">
        <StackPanel Margin="20">
            <Border Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="22"
                               FontWeight="SemiBold"
                               Text="Advanced Cleanup Tools" />
                    <TextBlock Margin="0,6,0,12"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="Find duplicate files, analyze stale data, and inspect cleanup snapshots." />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <ComboBox Grid.Column="0"
                                  Height="34"
                                  ItemsSource="{Binding AvailableRoots}"
                                  SelectedItem="{Binding SelectedRootPath, Mode=TwoWay}" />
                        <Button Grid.Column="1"
                                Margin="8,0,0,0"
                                Command="{Binding RefreshRootsCommand}"
                                Content="Refresh Roots" />
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Duplicate Finder" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding AnalyzeDuplicatesCommand}"
                                Content="Scan Duplicates" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding SimulateDuplicateCleanupCommand}"
                                Content="Simulate Selected" />
                        <Button Command="{Binding CommitDuplicateCleanupCommand}"
                                ToolTip="Deletes selected duplicates to Recycle Bin after confirmation and backup."
                                Content="Delete Selected" />
                    </WrapPanel>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Margin="0,0,18,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding DuplicatePotentialBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Potential reclaim: {0}}" />
                        <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding DuplicateSelectedBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Selected reclaim: {0}}" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding DuplicateStatus}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.15*" />
                            <ColumnDefinition Width="1.85*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  Margin="0,0,10,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding DuplicateGroups}"
                                  SelectedItem="{Binding SelectedDuplicateGroup, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding HashPrefix, Mode=OneWay}"
                                                    Header="Hash"
                                                    Width="100" />
                                <DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="File Size"
                                                    Width="100" />
                                <DataGridTextColumn Binding="{Binding Files.Count, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Copies"
                                                    Width="70" />
                                <DataGridTextColumn Binding="{Binding WastedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Wasted"
                                                    Width="100" />
                                <DataGridTextColumn Binding="{Binding SelectedDeleteCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Selected"
                                                    Width="80" />
                                <DataGridTextColumn Binding="{Binding RecommendedKeepName, Mode=OneWay}"
                                                    Header="Keep"
                                                    Width="160" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <StackPanel Grid.Column="1">
                            <TextBlock Margin="0,0,0,6"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding SelectedDuplicateGroup.RecommendedKeepPath, StringFormat=Recommended keep: {0}}" />
                            <TextBlock Margin="0,0,0,8"
                                       Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding SelectedDuplicateGroup.RecommendationReason}" />
                            <DataGrid AutoGenerateColumns="False"
                                      ItemsSource="{Binding SelectedDuplicateGroup.Files}">
                                <DataGrid.Columns>
                                    <DataGridCheckBoxColumn Binding="{Binding DeleteCandidate, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                            Header="Delete"
                                                            Width="70" />
                                    <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}"
                                                        Header="Name"
                                                        Width="180" />
                                    <DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                        Header="Size"
                                                        Width="90" />
                                    <DataGridTextColumn Binding="{Binding LastModifiedUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                        Header="Modified"
                                                        Width="140" />
                                    <DataGridTextColumn Binding="{Binding IsHardLinkAlias, Mode=OneWay}"
                                                        Header="Hardlink Alias"
                                                        Width="110" />
                                    <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                                        Header="Path"
                                                        Width="*" />
                                    <DataGridTemplateColumn Header="Open"
                                                            Width="70">
                                        <DataGridTemplateColumn.CellTemplate>
                                            <DataTemplate>
                                                <Button Padding="8,4"
                                                        Command="{Binding DataContext.OpenPathCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                        CommandParameter="{Binding FullPath}"
                                                        Content="Open" />
                                            </DataTemplate>
                                        </DataGridTemplateColumn.CellTemplate>
                                    </DataGridTemplateColumn>
                                </DataGrid.Columns>
                            </DataGrid>
                        </StackPanel>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Waste Analysis" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding AnalyzeWasteCommand}"
                                Content="Analyze Waste" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding CleanNeverAccessedSelectedCommand}"
                                ToolTip="Deletes the selected stale file after explicit confirmation."
                                Content="Delete Selected Never-Accessed File" />
                        <Button Command="{Binding OpenPathCommand}"
                                CommandParameter="{Binding SelectedNeverAccessedFile.FullPath}"
                                Content="Open Selected File" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding WasteStatus}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  Margin="0,0,10,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding TopExtensions}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                                    Header="Extension"
                                                    Width="120" />
                                <DataGridTextColumn Binding="{Binding FileCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Files"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Size"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Column="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding AgeBuckets}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Label, Mode=OneWay}"
                                                    Header="Age Bucket"
                                                    Width="120" />
                                <DataGridTextColumn Binding="{Binding FileCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Files"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Size"
                                                    Width="120" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>

                    <TextBlock Margin="0,12,0,6"
                               FontWeight="SemiBold"
                               Text="Never-Accessed Candidate Files (>= 365 days since last access)" />
                    <DataGrid AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding NeverAccessedFiles}"
                              SelectedItem="{Binding SelectedNeverAccessedFile, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}"
                                                Header="Name"
                                                Width="180" />
                            <DataGridTextColumn Binding="{Binding ParentFolder, Mode=OneWay}"
                                                Header="Folder"
                                                Width="*" />
                            <DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Size"
                                                Width="100" />
                            <DataGridTextColumn Binding="{Binding LastModifiedUtc, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm}}"
                                                Header="Modified"
                                                Width="140" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Treemap 2.0 + File-Type Analytics" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding AnalyzeStorageAnalyticsCommand}"
                                Content="Build Analytics" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding OpenSelectedTreemapPathCommand}"
                                Content="Open Selected Tile" />
                        <Button Command="{Binding DrillDownSelectedTreemapCommand}"
                                Content="Drill Down Selected" />
                    </WrapPanel>
                    <Grid Margin="0,10,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="110" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="120" />
                            <ColumnDefinition Width="280" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Path Filter" />
                        <TextBox Grid.Column="1"
                                 Margin="8,0,12,0"
                                 Text="{Binding TreemapSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="Category" />
                        <ComboBox Grid.Column="3"
                                  Margin="8,0,0,0"
                                  ItemsSource="{Binding TreemapCategoryFilters}"
                                  SelectedItem="{Binding SelectedTreemapCategoryFilter, Mode=TwoWay}" />
                    </Grid>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding AnalyticsStatus}" />

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="1.05*" />
                            <ColumnDefinition Width="1.95*" />
                        </Grid.ColumnDefinitions>

                        <DataGrid Grid.Column="0"
                                  Margin="0,0,10,0"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding FileTypeAnalyticsRows}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                                    Header="Category"
                                                    Width="140" />
                                <DataGridTextColumn Binding="{Binding FileCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Files"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding TotalBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Size"
                                                    Width="120" />
                                <DataGridTextColumn Binding="{Binding PercentageOfBytes, Mode=OneWay, StringFormat={}{0:0.00}%}"
                                                    Header="Percent"
                                                    Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <DataGrid Grid.Column="1"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding TreemapTiles}"
                                  SelectedItem="{Binding SelectedTreemapTile, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Name, Mode=OneWay}"
                                                    Header="Folder"
                                                    Width="170" />
                                <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                                    Header="Path"
                                                    Width="*" />
                                <DataGridTextColumn Binding="{Binding CategoryHint, Mode=OneWay}"
                                                    Header="Category"
                                                    Width="110" />
                                <DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Size"
                                                    Width="110" />
                                <DataGridTemplateColumn Header="Area"
                                                        Width="120">
                                    <DataGridTemplateColumn.CellTemplate>
                                        <DataTemplate>
                                            <ProgressBar Height="12"
                                                         Maximum="100"
                                                         Value="{Binding PercentageOfScanned}" />
                                        </DataTemplate>
                                    </DataGridTemplateColumn.CellTemplate>
                                </DataGridTemplateColumn>
                                <DataGridTextColumn Binding="{Binding PercentageOfScanned, Mode=OneWay, StringFormat={}{0:0.00}%}"
                                                    Header="%"
                                                    Width="70" />
                                <DataGridTextColumn Binding="{Binding Depth, Mode=OneWay}"
                                                    Header="Depth"
                                                    Width="70" />
                                <DataGridTextColumn Binding="{Binding FileCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Files"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding FolderCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                    Header="Folders"
                                                    Width="90" />
                            </DataGrid.Columns>
                        </DataGrid>
                    </Grid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Snapshot Diff (Before/After)" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding CaptureSnapshotCommand}"
                                Content="Capture Snapshot" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding RefreshSnapshotsCommand}"
                                Content="Refresh Snapshots" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding UseLatestSnapshotPairCommand}"
                                Content="Use Latest Pair" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding CompareSnapshotsCommand}"
                                Content="Compare" />
                    </WrapPanel>

                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="90" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Grid.Column="0"
                                   VerticalAlignment="Center"
                                   Text="Before" />
                        <ComboBox Grid.Column="1"
                                  Margin="8,0,12,0"
                                  DisplayMemberPath="DisplayLabel"
                                  ItemsSource="{Binding Snapshots}"
                                  SelectedItem="{Binding SelectedBeforeSnapshot, Mode=TwoWay}" />
                        <TextBlock Grid.Column="2"
                                   VerticalAlignment="Center"
                                   Text="After" />
                        <ComboBox Grid.Column="3"
                                  Margin="8,0,0,0"
                                  DisplayMemberPath="DisplayLabel"
                                  ItemsSource="{Binding Snapshots}"
                                  SelectedItem="{Binding SelectedAfterSnapshot, Mode=TwoWay}" />
                    </Grid>

                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Margin="0,0,18,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding BeforeSnapshotBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Before: {0}}" />
                        <TextBlock Margin="0,0,18,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding AfterSnapshotBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=After: {0}}" />
                        <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding SnapshotDeltaBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Net delta: {0}}" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SnapshotStatus}" />

                    <TextBlock Margin="0,12,0,6"
                               FontWeight="SemiBold"
                               Text="Category Impact (Actions Between Snapshots)" />
                    <DataGrid AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding CategoryDiffRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                                Header="Category"
                                                Width="170" />
                            <DataGridTextColumn Binding="{Binding ReclaimedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Reclaimed"
                                                Width="120" />
                            <DataGridTextColumn Binding="{Binding SuccessCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                Header="Success"
                                                Width="90" />
                            <DataGridTextColumn Binding="{Binding FailedCount, Mode=OneWay, StringFormat={}{0:N0}}"
                                                Header="Failed"
                                                Width="90" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="0,12,0,6"
                               FontWeight="SemiBold"
                               Text="Largest Folder Changes" />
                    <DataGrid AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding FolderDiffRows}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                                Header="Folder"
                                                Width="*" />
                            <DataGridTextColumn Binding="{Binding BeforeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Before"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding AfterBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="After"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding DeltaBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Delta"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding DeltaFiles, Mode=OneWay, StringFormat={}{0:N0}}"
                                                Header="File Delta"
                                                Width="100" />
                        </DataGrid.Columns>
                    </DataGrid>

                    <TextBlock Margin="0,12,0,6"
                               FontWeight="SemiBold"
                               Text="Actions Causing Differences" />
                    <DataGrid AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding DiffActions}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Header="Time"
                                                Width="160" />
                            <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                                Header="Category"
                                                Width="130" />
                            <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                                Header="Path"
                                                Width="*" />
                            <DataGridTextColumn Binding="{Binding ReclaimedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Reclaimed"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding Success, Mode=OneWay}"
                                                Header="Success"
                                                Width="70" />
                            <DataGridTextColumn Binding="{Binding QueuedForReboot, Mode=OneWay}"
                                                Header="Queued"
                                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Restore Center" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding RefreshRestoreEntriesCommand}"
                                Content="Refresh Restore Center" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding OpenRestoreOriginalPathCommand}"
                                Content="Open Original Path" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding OpenRestoreVaultPathCommand}"
                                Content="Open Backup Location" />
                        <Button Margin="0,0,8,0"
                                Command="{Binding RestoreSelectedEntryCommand}"
                                Content="Restore Selected" />
                        <Button Command="{Binding PurgeSelectedEntryCommand}"
                                ToolTip="Permanently removes backup from Restore Center."
                                Content="Purge Backup" />
                    </WrapPanel>
                    <TextBlock Margin="0,8,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding RestoreStatus}" />
                    <DataGrid Margin="0,12,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding RestoreEntries}"
                              SelectedItem="{Binding SelectedRestoreEntry, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding BackedUpAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Header="Backed Up"
                                                Width="160" />
                            <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                                Header="Category"
                                                Width="120" />
                            <DataGridTextColumn Binding="{Binding SizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Size"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding State, Mode=OneWay}"
                                                Header="State"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding OriginalPath, Mode=OneWay}"
                                                Header="Original Path"
                                                Width="2*" />
                            <DataGridTextColumn Binding="{Binding VaultPath, Mode=OneWay}"
                                                Header="Backup Path"
                                                Width="2*" />
                            <DataGridTextColumn Binding="{Binding RunId, Mode=OneWay}"
                                                Header="Run ID"
                                                Width="230" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>

            <Border Margin="0,16,0,0"
                    Style="{StaticResource CardStyle}">
                <StackPanel>
                    <TextBlock FontSize="20"
                               FontWeight="SemiBold"
                               Text="Cleanup Run Manifests" />
                    <WrapPanel Margin="0,10,0,0">
                        <Button Margin="0,0,8,0"
                                Command="{Binding RefreshRunsCommand}"
                                Content="Refresh Runs" />
                        <Button Command="{Binding ExportSelectedRunCommand}"
                                Content="Export Selected Manifest" />
                    </WrapPanel>

                    <DataGrid Margin="0,12,0,0"
                              AutoGenerateColumns="False"
                              IsReadOnly="True"
                              ItemsSource="{Binding RecentRuns}"
                              SelectedItem="{Binding SelectedRun, Mode=TwoWay}">
                        <DataGrid.Columns>
                            <DataGridTextColumn Binding="{Binding RunId, Mode=OneWay}"
                                                Header="Run ID"
                                                Width="230" />
                            <DataGridTextColumn Binding="{Binding StartedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Header="Started"
                                                Width="160" />
                            <DataGridTextColumn Binding="{Binding CompletedAt, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                                Header="Completed"
                                                Width="160" />
                            <DataGridTextColumn Binding="{Binding IsSimulation, Mode=OneWay}"
                                                Header="Simulation"
                                                Width="90" />
                            <DataGridTextColumn Binding="{Binding EstimatedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Estimated"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding ReclaimedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                Header="Reclaimed"
                                                Width="110" />
                            <DataGridTextColumn Binding="{Binding Results.Count, Mode=OneWay, StringFormat={}{0:N0}}"
                                                Header="Items"
                                                Width="70" />
                        </DataGrid.Columns>
                    </DataGrid>
                </StackPanel>
            </Border>
        </StackPanel>
    </ScrollViewer>
</UserControl>
