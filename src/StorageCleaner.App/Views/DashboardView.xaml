<UserControl x:Class="StorageCleaner.App.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.Resources>
        <Style x:Key="TileIconButtonStyle"
               TargetType="Button">
            <Setter Property="MinHeight"
                    Value="120" />
            <Setter Property="HorizontalAlignment"
                    Value="Stretch" />
            <Setter Property="VerticalAlignment"
                    Value="Stretch" />
            <Setter Property="Padding"
                    Value="8" />
            <Setter Property="Background"
                    Value="{DynamicResource SurfaceBrush}" />
            <Setter Property="BorderBrush"
                    Value="{DynamicResource BorderBrush}" />
            <Setter Property="BorderThickness"
                    Value="1" />
            <Setter Property="Cursor"
                    Value="Hand" />
            <Setter Property="ToolTip"
                    Value="Open feature" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="IconBorder"
                                Background="{TemplateBinding Background}"
                                BorderBrush="{TemplateBinding BorderBrush}"
                                BorderThickness="{TemplateBinding BorderThickness}"
                                CornerRadius="10">
                            <Grid>
                                <Ellipse Width="88"
                                         Height="88"
                                         HorizontalAlignment="Center"
                                         VerticalAlignment="Center"
                                         Fill="{DynamicResource ElevatedSurfaceBrush}"
                                         Opacity="0.55" />
                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center" />
                                <TextBlock Margin="0,0,10,8"
                                           HorizontalAlignment="Right"
                                           VerticalAlignment="Bottom"
                                           FontSize="12"
                                           Foreground="{DynamicResource SubtleTextBrush}"
                                           Text="Open" />
                            </Grid>
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="IconBorder"
                                        Property="BorderBrush"
                                        Value="{DynamicResource AccentBrush}" />
                                <Setter TargetName="IconBorder"
                                        Property="Background"
                                        Value="{DynamicResource ElevatedSurfaceBrush}" />
                            </Trigger>
                            <Trigger Property="IsPressed"
                                     Value="True">
                                <Setter TargetName="IconBorder"
                                        Property="Background"
                                        Value="{DynamicResource SelectionBrush}" />
                            </Trigger>
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter Property="Cursor"
                                        Value="Arrow" />
                                <Setter Property="ToolTip"
                                        Value="Coming soon" />
                                <Setter TargetName="IconBorder"
                                        Property="Opacity"
                                        Value="0.6" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </UserControl.Resources>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Feature Launcher"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,16"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       Text="Choose a storage tool and work safely." />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           Margin="0,0,0,12"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="Home"
                           FontWeight="SemiBold" />

                <ScrollViewer Grid.Row="1"
                              x:Name="TileScrollViewer"
                              VerticalScrollBarVisibility="Auto"
                              HorizontalScrollBarVisibility="Disabled">
                    <Grid MinHeight="{Binding ElementName=TileScrollViewer, Path=ViewportHeight}">
                        <ItemsControl ItemsSource="{Binding FeatureTiles}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="{Binding ElementName=TileScrollViewer, Path=ViewportWidth, Converter={StaticResource ViewportToColumnsConverter}}" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Margin="0,0,12,12"
                                            Padding="14"
                                            Background="{DynamicResource ElevatedSurfaceBrush}"
                                            BorderBrush="{DynamicResource BorderBrush}"
                                            BorderThickness="1"
                                            CornerRadius="12">
                                        <Grid>
                                            <Grid.RowDefinitions>
                                                <RowDefinition Height="*" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                                <RowDefinition Height="Auto" />
                                            </Grid.RowDefinitions>

                                            <Button Grid.Row="0"
                                                    Margin="0,0,0,12"
                                                    Style="{StaticResource TileIconButtonStyle}"
                                                    Command="{Binding DataContext.NavigateToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding TargetSection}"
                                                    IsEnabled="{Binding IsAvailable}">
                                                <TextBlock FontFamily="Segoe MDL2 Assets"
                                                           FontSize="30"
                                                           Text="{Binding IconGlyph}" />
                                            </Button>

                                            <TextBlock Grid.Row="1"
                                                       FontSize="18"
                                                       FontWeight="SemiBold"
                                                       Text="{Binding Title}" />
                                            <TextBlock Grid.Row="2"
                                                       Margin="0,6,0,0"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       Text="{Binding Description}"
                                                       TextWrapping="Wrap" />
                                            <TextBlock Grid.Row="3"
                                                       Margin="0,12,0,0"
                                                       VerticalAlignment="Center"
                                                       Foreground="{DynamicResource SubtleTextBrush}"
                                                       Text="{Binding DestinationHint}">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Visibility"
                                                                Value="Visible" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding DestinationHint}"
                                                                         Value="">
                                                                <Setter Property="Visibility"
                                                                        Value="Collapsed" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </Grid>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </Grid>
                </ScrollViewer>
            </Grid>
        </Border>
    </Grid>
</UserControl>
