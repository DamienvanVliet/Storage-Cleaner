<UserControl x:Class="StorageCleaner.App.Views.AppUninstallerView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:StorageCleaner.App.Models"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl"
                    Key="R"
                    Command="{Binding RefreshAppsCommand}" />
        <KeyBinding Modifiers="Ctrl+Shift"
                    Key="A"
                    Command="{Binding SelectAllSafeItemsCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <StackPanel Grid.Column="0">
                        <TextBlock FontSize="22"
                                   FontWeight="SemiBold"
                                   Text="App Uninstaller" />
                        <TextBlock Margin="0,4,0,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Review apps and leftovers, then uninstall or clean only after explicit confirmation.">
                            <TextBlock.Style>
                                <Style TargetType="TextBlock">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsCompactMode}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </TextBlock.Style>
                        </TextBlock>
                    </StackPanel>
                    <CheckBox Grid.Column="1"
                              Margin="12,0,0,0"
                              VerticalAlignment="Center"
                              IsChecked="{Binding IsCompactMode, Mode=TwoWay}">
                        <TextBlock Text="Compact mode" />
                    </CheckBox>
                </Grid>

                <WrapPanel Margin="0,12,0,0">
                    <Button Margin="0,0,8,0"
                            Command="{Binding RefreshAppsCommand}"
                            Content="Refresh Apps" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding ScanLeftoversCommand}"
                            Content="Scan Leftovers" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SelectAllSafeItemsCommand}"
                            Content="Select Safe" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding SelectNoneCommand}"
                            Content="Select None" />
                    <Button Margin="0,0,8,0"
                            Command="{Binding ExportReportCommand}"
                            Content="Export Report" />
                    <Button Margin="0,0,8,0"
                            ToolTip="Requires typed confirmation"
                            Command="{Binding UninstallSelectedCommand}"
                            Content="Uninstall Selected" />
                    <Button ToolTip="Deletes leftovers to Recycle Bin with restore backup"
                            Command="{Binding DeleteSelectedLeftoversCommand}"
                            Content="Clean Leftovers" />
                </WrapPanel>

                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="145" />
                        <ColumnDefinition Width="220" />
                        <ColumnDefinition Width="220" />
                    </Grid.ColumnDefinitions>

                    <ComboBox Grid.Column="0"
                              Height="34"
                              ItemsSource="{Binding AppRecommendationFilters}"
                              SelectedItem="{Binding SelectedAppRecommendationFilter, Mode=TwoWay}" />
                    <TextBox Grid.Column="1"
                             Margin="8,0,12,0"
                             ToolTip="Search apps"
                             Text="{Binding AppSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <ComboBox Grid.Column="2"
                              Height="34"
                              ItemsSource="{Binding LeftoverRecommendationFilters}"
                              SelectedItem="{Binding SelectedLeftoverRecommendationFilter, Mode=TwoWay}" />
                    <TextBox Grid.Column="3"
                             Margin="8,0,0,0"
                             ToolTip="Search leftover paths"
                             Text="{Binding LeftoverSearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                    <WrapPanel Grid.Column="4"
                               Margin="8,0,0,0"
                               HorizontalAlignment="Right">
                        <Button Margin="0,0,8,0"
                                Command="{Binding PreviewUninstallSelectedCommand}"
                                Content="Preview Uninstall" />
                        <Button Command="{Binding PreviewLeftoverCleanupCommand}"
                                Content="Preview Cleanup" />
                    </WrapPanel>
                </Grid>

                <UniformGrid Margin="0,12,0,0"
                             Columns="4">
                    <Border Margin="0,0,8,0"
                            Padding="10"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Installed Apps" />
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding TotalInstalledApps, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0"
                            Padding="10"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Leftovers Found" />
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding LeftoversFoundCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </Border>
                    <Border Margin="0,0,8,0"
                            Padding="10"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Space Reclaimable" />
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding ReclaimableBytes, Converter={StaticResource BytesToSizeConverter}}" />
                        </StackPanel>
                    </Border>
                    <Border Padding="10"
                            Background="{DynamicResource ElevatedSurfaceBrush}"
                            BorderBrush="{DynamicResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8">
                        <StackPanel>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="Selected" />
                            <TextBlock FontSize="20"
                                       FontWeight="SemiBold"
                                       Text="{Binding SelectedCombinedCount, StringFormat={}{0:N0}}" />
                        </StackPanel>
                    </Border>
                </UniformGrid>

                <WrapPanel Margin="0,10,0,0">
                    <TextBlock Margin="0,0,16,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SelectedAppCount, StringFormat=Apps selected: {0:N0}}" />
                    <TextBlock Margin="0,0,16,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SelectedAppEstimatedBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=App size: {0}}" />
                    <TextBlock Margin="0,0,16,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SelectedLeftoverCount, StringFormat=Leftovers selected: {0:N0}}" />
                    <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding SelectedLeftoverBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Leftover size: {0}}" />
                </WrapPanel>

                <ProgressBar Margin="0,8,0,0"
                             Height="12"
                             IsIndeterminate="True">
                    <ProgressBar.Style>
                        <Style TargetType="ProgressBar"
                               BasedOn="{StaticResource {x:Type ProgressBar}}">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding IsBusy}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </ProgressBar.Style>
                </ProgressBar>

                <TextBlock Margin="0,8,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding StatusText}" />

                <Border Margin="0,8,0,0"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowPermissionWarning}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding PermissionWarningText}" />
                </Border>

                <Border Margin="0,8,0,0"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource AccentBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowSuccessBanner}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Text="{Binding SuccessBannerText}" />
                </Border>

                <Border Margin="0,8,0,0"
                        Padding="10"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowUndoBanner}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <DockPanel>
                        <TextBlock VerticalAlignment="Center"
                                   Text="{Binding UndoBannerText}" />
                        <Button DockPanel.Dock="Right"
                                Margin="12,0,0,0"
                                Command="{Binding DataContext.NavigateToSectionCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                CommandParameter="{x:Static models:NavigationSection.AdvancedTools}"
                                Content="Open Restore Center" />
                    </DockPanel>
                </Border>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="1.9*" />
                    <ColumnDefinition Width="1.1*" />
                </Grid.ColumnDefinitions>

                <Grid Grid.Column="0"
                      Margin="0,0,10,0">
                    <Grid.RowDefinitions>
                        <RowDefinition x:Name="AppsRowDefinition"
                                       Height="1.2*" />
                        <RowDefinition x:Name="LeftoversRowDefinition"
                                       Height="1*" />
                    </Grid.RowDefinitions>

                    <Grid Grid.Row="0"
                          Margin="0,0,0,10">
                        <DataGrid AutoGenerateColumns="False"
                                  ItemsSource="{Binding FilteredInstalledApps}"
                                  SelectedItem="{Binding SelectedApp, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Header="Select"
                                                        Width="65" />
                                <DataGridTextColumn Binding="{Binding Recommendation, Mode=OneWay}"
                                                    Header="Recommendation"
                                                    Width="110" />
                                <DataGridTextColumn Binding="{Binding SafetyScore, Mode=OneWay}"
                                                    Header="Safety"
                                                    Width="65" />
                                <DataGridTextColumn Binding="{Binding DisplayName, Mode=OneWay}"
                                                    Header="App"
                                                    Width="180" />
                                <DataGridTextColumn Binding="{Binding Publisher, Mode=OneWay}"
                                                    Header="Publisher"
                                                    Width="140" />
                                <DataGridTextColumn Binding="{Binding Version, Mode=OneWay}"
                                                    Header="Version"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding EstimatedSizeBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Size"
                                                    Width="100" />
                                <DataGridTextColumn Binding="{Binding LastUsedLocal, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd}}"
                                                    Header="Last Used"
                                                    Width="110" />
                                <DataGridTextColumn Binding="{Binding InstallLocation, Mode=OneWay}"
                                                    Header="Install Location"
                                                    Width="*" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="14"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowAppsEmptyState}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding AppEmptyStateText}" />
                        </Border>
                    </Grid>

                    <Grid Grid.Row="1">
                        <DataGrid AutoGenerateColumns="False"
                                  ItemsSource="{Binding FilteredLeftovers}"
                                  SelectedItem="{Binding SelectedLeftover, Mode=TwoWay}">
                            <DataGrid.Columns>
                                <DataGridCheckBoxColumn Binding="{Binding IsSelected, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}"
                                                        Header="Select"
                                                        Width="65" />
                                <DataGridTextColumn Binding="{Binding Recommendation, Mode=OneWay}"
                                                    Header="Recommendation"
                                                    Width="110" />
                                <DataGridTextColumn Binding="{Binding SafetyScore, Mode=OneWay}"
                                                    Header="Safety"
                                                    Width="65" />
                                <DataGridTextColumn Binding="{Binding AppName, Mode=OneWay}"
                                                    Header="App"
                                                    Width="140" />
                                <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                                    Header="Path"
                                                    Width="*" />
                                <DataGridTextColumn Binding="{Binding EstimatedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                                    Header="Size"
                                                    Width="100" />
                                <DataGridTextColumn Binding="{Binding RiskLabel, Mode=OneWay}"
                                                    Header="Risk"
                                                    Width="75" />
                                <DataGridTextColumn Binding="{Binding Reason, Mode=OneWay}"
                                                    Header="Reason"
                                                    Width="170" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <Border Padding="14"
                                Background="{DynamicResource ElevatedSurfaceBrush}"
                                BorderBrush="{DynamicResource BorderBrush}"
                                BorderThickness="1"
                                CornerRadius="8"
                                HorizontalAlignment="Center"
                                VerticalAlignment="Center">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Setter Property="Visibility"
                                            Value="Collapsed" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ShowLeftoversEmptyState}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Visible" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                            <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                       Text="{Binding LeftoverEmptyStateText}" />
                        </Border>
                    </Grid>
                </Grid>

                <Border Grid.Column="1"
                        Padding="12"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="10">
                    <Grid>
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="1*" />
                            <RowDefinition Height="Auto" />
                        </Grid.RowDefinitions>

                        <TextBlock Grid.Row="0"
                                   FontSize="18"
                                   FontWeight="SemiBold"
                                   Text="Preview Drawer" />

                        <TextBlock Grid.Row="1"
                                   Margin="0,6,0,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Review queued uninstall and leftover cleanup items before executing actions." />

                        <DataGrid Grid.Row="2"
                                  Margin="0,10,0,10"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding UninstallPreviewItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding DisplayName, Mode=OneWay}"
                                                    Header="Uninstall Preview"
                                                    Width="*" />
                                <DataGridTextColumn Binding="{Binding SizeDisplay, Mode=OneWay}"
                                                    Header="Size"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding Recommendation, Mode=OneWay}"
                                                    Header="Recommendation"
                                                    Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="3">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding OpenInstallLocationCommand}"
                                    Content="Open App Folder" />
                            <Button Command="{Binding PreviewUninstallSelectedCommand}"
                                    Content="Preview Uninstall" />
                        </WrapPanel>

                        <DataGrid Grid.Row="4"
                                  Margin="0,10,0,10"
                                  AutoGenerateColumns="False"
                                  IsReadOnly="True"
                                  ItemsSource="{Binding CleanupPreviewItems}">
                            <DataGrid.Columns>
                                <DataGridTextColumn Binding="{Binding Path, Mode=OneWay}"
                                                    Header="Cleanup Preview"
                                                    Width="*" />
                                <DataGridTextColumn Binding="{Binding SizeDisplay, Mode=OneWay}"
                                                    Header="Size"
                                                    Width="90" />
                                <DataGridTextColumn Binding="{Binding Recommendation, Mode=OneWay}"
                                                    Header="Recommendation"
                                                    Width="110" />
                            </DataGrid.Columns>
                        </DataGrid>

                        <WrapPanel Grid.Row="5">
                            <Button Margin="0,0,8,0"
                                    Command="{Binding OpenLeftoverLocationCommand}"
                                    Content="Open Leftover" />
                            <Button Margin="0,0,8,0"
                                    Command="{Binding PreviewLeftoverCleanupCommand}"
                                    Content="Preview Cleanup" />
                            <Button Command="{Binding DeleteSelectedLeftoversCommand}"
                                    Content="Clean Selected" />
                        </WrapPanel>
                    </Grid>
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
