<UserControl x:Class="StorageCleaner.App.Views.ScanDriveView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl"
                    Key="R"
                    Command="{Binding StartScanCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <StackPanel Grid.Row="0">
            <TextBlock Text="Scan Drive or Folder"
                       FontSize="26"
                       FontWeight="SemiBold" />
            <TextBlock Margin="0,4,0,16"
                       Foreground="{DynamicResource SubtleTextBrush}"
                       Text="Run high-performance recursive scans with pause, resume, and cancel." />
        </StackPanel>

        <Border Grid.Row="1"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <TextBlock FontSize="18"
                           FontWeight="SemiBold"
                           Text="Scan Target" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Height="34"
                              VerticalContentAlignment="Center"
                              ItemsSource="{Binding AvailableRoots}"
                              SelectedItem="{Binding SelectedRootPath, Mode=TwoWay}" />
                    <Button Grid.Column="1"
                            Margin="8,0,0,0"
                            Command="{Binding RefreshDrivesCommand}"
                            Content="Refresh Drives" />
                    <Button Grid.Column="2"
                            Margin="8,0,0,0"
                            Command="{Binding BrowseFolderCommand}"
                            Content="Browse Folder" />
                </Grid>
                <Grid Margin="0,10,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="140" />
                        <ColumnDefinition Width="260" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <TextBlock VerticalAlignment="Center"
                               Text="Scan mode" />
                    <ComboBox Grid.Column="1"
                              Margin="8,0,0,0"
                              ItemsSource="{Binding ScanModes}"
                              SelectedItem="{Binding SelectedScanMode, Mode=TwoWay}" />
                    <TextBlock Grid.Column="2"
                               Margin="12,0,0,0"
                               VerticalAlignment="Center"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="NTFS Fast uses USN/MFT-assisted checks when available and falls back automatically." />
                </Grid>
                <StackPanel Margin="0,14,0,0"
                            Orientation="Horizontal">
                    <Button Width="120"
                            Height="34"
                            Command="{Binding StartScanCommand}"
                            ToolTip="Shortcut: Ctrl+R"
                            Content="Scan Now" />
                    <Button Width="120"
                            Height="34"
                            Margin="8,0,0,0"
                            Command="{Binding PauseOrResumeCommand}">
                        <Button.Style>
                            <Style TargetType="Button"
                                   BasedOn="{StaticResource {x:Type Button}}">
                                <Setter Property="Content"
                                        Value="Pause" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanWorkspace.IsPaused}"
                                                 Value="True">
                                        <Setter Property="Content"
                                                Value="Resume" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                    <Button Width="120"
                            Height="34"
                            Margin="8,0,0,0"
                            Command="{Binding CancelScanCommand}"
                            Content="Cancel" />
                </StackPanel>
            </StackPanel>
        </Border>

        <Border Grid.Row="2"
                Margin="0,16,0,0"
                Style="{StaticResource CardStyle}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0"
                           FontSize="18"
                           FontWeight="SemiBold"
                           Text="Progress" />
                <TextBlock Grid.Row="1"
                           Margin="0,8,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding ScanWorkspace.StatusMessage}" />
                <TextBlock Grid.Row="2"
                           Margin="0,6,0,0"
                           Foreground="{DynamicResource DangerBrush}"
                           Text="{Binding ScanWorkspace.LastErrorMessage}" />

                <StackPanel Grid.Row="3"
                            Margin="0,12,0,0">
                    <ProgressBar Height="12"
                                 Maximum="100"
                                 Value="{Binding ScanWorkspace.CurrentProgress.Percentage, Mode=OneWay}">
                        <ProgressBar.Style>
                            <Style TargetType="ProgressBar"
                                   BasedOn="{StaticResource {x:Type ProgressBar}}">
                                <Setter Property="IsIndeterminate"
                                        Value="False" />
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding ScanWorkspace.IsScanning}"
                                                 Value="True">
                                        <Setter Property="IsIndeterminate"
                                                Value="True" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </ProgressBar.Style>
                    </ProgressBar>
                    <TextBlock Margin="0,6,0,0"
                               Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding ScanWorkspace.CurrentProgress.Percentage, StringFormat=Progress: {0:0.0}%}" />
                    <Grid Margin="0,12,0,0">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="Auto" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="Current path:" />
                        <TextBlock Grid.Column="1"
                                   Margin="8,0,0,0"
                                   Text="{Binding ScanWorkspace.CurrentProgress.CurrentPath}"
                                   TextTrimming="CharacterEllipsis" />
                    </Grid>
                    <WrapPanel Margin="0,10,0,0">
                        <TextBlock Margin="0,0,16,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ScanWorkspace.CurrentProgress.ProcessedDirectories, StringFormat=Folders: {0:N0}}" />
                        <TextBlock Margin="0,0,16,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ScanWorkspace.CurrentProgress.ProcessedFiles, StringFormat=Files: {0:N0}}" />
                        <TextBlock Margin="0,0,16,0"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ScanWorkspace.CurrentProgress.ProcessedBytes, Converter={StaticResource BytesToSizeConverter}, StringFormat=Data: {0}}" />
                        <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ScanWorkspace.CurrentProgress.Elapsed, StringFormat=Elapsed: {0:g}}" />
                    </WrapPanel>
                </StackPanel>

                <TextBlock Grid.Row="4"
                           Margin="0,14,0,0"
                           FontWeight="SemiBold"
                           Text="{Binding ScanWorkspace.LastIssues.Count, StringFormat=Scan Warnings: {0}}" />
                <DataGrid Grid.Row="5"
                          Margin="0,8,0,0"
                          AutoGenerateColumns="False"
                          CanUserSortColumns="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding ScanWorkspace.LastIssues}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding ExceptionType, Mode=OneWay}"
                                            Header="Type"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding Path, Mode=OneWay}"
                                            Header="Path"
                                            Width="2*" />
                        <DataGridTextColumn Binding="{Binding Message, Mode=OneWay}"
                                            Header="Message"
                                            Width="2*" />
                        <DataGridTextColumn Binding="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Header="Time"
                                            Width="160" />
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
