<UserControl x:Class="StorageCleaner.App.Views.CleanupHistoryView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             mc:Ignorable="d">
    <UserControl.InputBindings>
        <KeyBinding Modifiers="Ctrl"
                    Key="R"
                    Command="{Binding RefreshCommand}" />
    </UserControl.InputBindings>

    <Grid Margin="20">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0"
                Style="{StaticResource CardStyle}">
            <StackPanel>
                <DockPanel>
                    <TextBlock DockPanel.Dock="Left"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Text="Cleanup History" />
                    <Button DockPanel.Dock="Right"
                            Command="{Binding RefreshCommand}"
                            Content="Refresh" />
                </DockPanel>
                <TextBlock Margin="0,6,0,0"
                           Foreground="{DynamicResource SubtleTextBrush}"
                           Text="{Binding StatusText}" />
                <Grid Margin="0,12,0,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="190" />
                        <ColumnDefinition Width="*" />
                    </Grid.ColumnDefinitions>
                    <ComboBox Grid.Column="0"
                              Height="34"
                              Margin="0,0,8,0"
                              ItemsSource="{Binding CategoryFilters}"
                              SelectedItem="{Binding SelectedCategoryFilter, Mode=TwoWay}" />
                    <TextBox Grid.Column="1"
                             Height="34"
                             ToolTip="Search run id, path, or error message"
                             Text="{Binding SearchText, Mode=TwoWay, UpdateSourceTrigger=PropertyChanged}" />
                </Grid>
            </StackPanel>
        </Border>

        <Border Grid.Row="1"
                Margin="0,16,0,0"
                Style="{StaticResource CardStyle}">
            <Grid>
                <DataGrid AutoGenerateColumns="False"
                          IsReadOnly="True"
                          ItemsSource="{Binding FilteredEntries}">
                    <DataGrid.Columns>
                        <DataGridTextColumn Binding="{Binding Timestamp, Mode=OneWay, StringFormat={}{0:yyyy-MM-dd HH:mm:ss}}"
                                            Header="Timestamp"
                                            Width="170" />
                        <DataGridTextColumn Binding="{Binding RunId, Mode=OneWay}"
                                            Header="Run"
                                            Width="180" />
                        <DataGridTextColumn Binding="{Binding Category, Mode=OneWay}"
                                            Header="Category"
                                            Width="120" />
                        <DataGridTextColumn Binding="{Binding FullPath, Mode=OneWay}"
                                            Header="Path"
                                            Width="*" />
                        <DataGridTextColumn Binding="{Binding ReclaimedBytes, Mode=OneWay, Converter={StaticResource BytesToSizeConverter}}"
                                            Header="Reclaimed"
                                            Width="100" />
                        <DataGridTextColumn Binding="{Binding SentToRecycleBin, Mode=OneWay}"
                                            Header="Recycle Bin"
                                            Width="90" />
                        <DataGridTextColumn Binding="{Binding IsSimulation, Mode=OneWay}"
                                            Header="Simulation"
                                            Width="90" />
                        <DataGridTextColumn Binding="{Binding QueuedForReboot, Mode=OneWay}"
                                            Header="Queued Reboot"
                                            Width="110" />
                        <DataGridTextColumn Binding="{Binding Success, Mode=OneWay}"
                                            Header="Success"
                                            Width="80" />
                        <DataGridTextColumn Binding="{Binding LockDetails, Mode=OneWay}"
                                            Header="Lock Details"
                                            Width="180" />
                        <DataGridTextColumn Binding="{Binding ErrorMessage, Mode=OneWay}"
                                            Header="Error"
                                            Width="220" />
                    </DataGrid.Columns>
                </DataGrid>
                <Border Padding="14"
                        Background="{DynamicResource ElevatedSurfaceBrush}"
                        BorderBrush="{DynamicResource BorderBrush}"
                        BorderThickness="1"
                        CornerRadius="8"
                        HorizontalAlignment="Center"
                        VerticalAlignment="Center">
                    <Border.Style>
                        <Style TargetType="Border">
                            <Setter Property="Visibility"
                                    Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding ShowEmptyState}"
                                             Value="True">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Border.Style>
                    <TextBlock Foreground="{DynamicResource SubtleTextBrush}"
                               Text="{Binding EmptyStateText}" />
                </Border>
            </Grid>
        </Border>
    </Grid>
</UserControl>
