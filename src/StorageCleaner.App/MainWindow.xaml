<Window x:Class="StorageCleaner.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:viewModels="clr-namespace:StorageCleaner.App.ViewModels"
        xmlns:views="clr-namespace:StorageCleaner.App.Views"
        mc:Ignorable="d"
        Title="Storage Cleaner"
        Background="{DynamicResource AppBackgroundBrush}"
        Width="1480"
        Height="900"
        MinWidth="1200"
        MinHeight="760">
    <Window.InputBindings>
        <KeyBinding Key="BrowserBack"
                    Command="{Binding NavigateHomeCommand}" />
        <KeyBinding Modifiers="Alt"
                    Key="Left"
                    Command="{Binding NavigateHomeCommand}" />
    </Window.InputBindings>

    <Window.Resources>
        <DataTemplate DataType="{x:Type viewModels:DashboardViewModel}">
            <views:DashboardView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:ScanDriveViewModel}">
            <views:ScanDriveView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:FolderExplorerViewModel}">
            <views:FolderExplorerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SafeCleanupViewModel}">
            <views:SafeCleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:PhotoCleanupViewModel}">
            <views:PhotoCleanupView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AppUninstallerViewModel}">
            <views:AppUninstallerView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:AdvancedToolsViewModel}">
            <views:AdvancedToolsView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:CleanupHistoryViewModel}">
            <views:CleanupHistoryView />
        </DataTemplate>
        <DataTemplate DataType="{x:Type viewModels:SettingsViewModel}">
            <views:SettingsView />
        </DataTemplate>
    </Window.Resources>

    <Grid Background="{DynamicResource AppBackgroundBrush}">
        <Grid Margin="0,10,10,10">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border Grid.Row="0"
                    Style="{StaticResource CardStyle}">
                <DockPanel>
                    <StackPanel Orientation="Horizontal">
                        <Button Width="42"
                                Height="34"
                                Margin="0,0,10,0"
                                Padding="0"
                                Command="{Binding NavigateHomeCommand}"
                                Content="&#x2190;">
                            <Button.Style>
                                <Style TargetType="Button"
                                       BasedOn="{StaticResource {x:Type Button}}">
                                    <Setter Property="Visibility"
                                            Value="Visible" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsHomeScreen}"
                                                     Value="True">
                                            <Setter Property="Visibility"
                                                    Value="Collapsed" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                        <TextBlock VerticalAlignment="Center"
                                   FontSize="26"
                                   FontWeight="SemiBold"
                                   Text="{Binding CurrentSectionTitle}" />
                    </StackPanel>
                    <StackPanel DockPanel.Dock="Right"
                                Orientation="Horizontal">
                        <TextBlock Margin="0,0,12,0"
                                   VerticalAlignment="Center"
                                   Foreground="{DynamicResource SubtleTextBrush}"
                                   Text="{Binding ScanWorkspace.StatusMessage}" />
                        <Ellipse Width="12"
                                 Height="12"
                                 VerticalAlignment="Center"
                                 Fill="{DynamicResource AccentBrush}">
                            <Ellipse.Style>
                                <Style TargetType="Ellipse">
                                    <Setter Property="Opacity"
                                            Value="0.35" />
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding ScanWorkspace.IsScanning}"
                                                     Value="True">
                                            <Setter Property="Opacity"
                                                    Value="1" />
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Ellipse.Style>
                        </Ellipse>
                    </StackPanel>
                </DockPanel>
            </Border>

            <Border Grid.Row="1"
                    Margin="0,12,0,0"
                    Background="{DynamicResource SurfaceBrush}"
                    BorderBrush="{DynamicResource BorderBrush}"
                    BorderThickness="1"
                    CornerRadius="14">
                <ContentControl Content="{Binding CurrentPageViewModel}" />
            </Border>
        </Grid>
    </Grid>
</Window>
