<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="Color.Background">#FF030B14</Color>
    <Color x:Key="Color.Surface">#FF081A2D</Color>
    <Color x:Key="Color.ElevatedSurface">#FF0E233A</Color>
    <Color x:Key="Color.Sidebar">#FF061525</Color>
    <Color x:Key="Color.Border">#FF2D4F76</Color>
    <Color x:Key="Color.Text">#FFDCEBFF</Color>
    <Color x:Key="Color.StrongText">#FFF2F8FF</Color>
    <Color x:Key="Color.SubtleText">#FFB4CBE8</Color>
    <Color x:Key="Color.Accent">#FF2F98FF</Color>
    <Color x:Key="Color.AccentHover">#FF4AA9FF</Color>
    <Color x:Key="Color.AccentPressed">#FF197FE2</Color>
    <Color x:Key="Color.OnAccent">#FFFCFFFF</Color>
    <Color x:Key="Color.Selection">#FF2A659B</Color>
    <Color x:Key="Color.DisabledText">#FFB9CAE0</Color>
    <Color x:Key="Color.DisabledSurface">#FF17314D</Color>
    <Color x:Key="Color.Danger">#FFFF9F97</Color>

    <SolidColorBrush x:Key="AppBackgroundBrush"
                     Color="{StaticResource Color.Background}" />
    <SolidColorBrush x:Key="SurfaceBrush"
                     Color="{StaticResource Color.Surface}" />
    <SolidColorBrush x:Key="ElevatedSurfaceBrush"
                     Color="{StaticResource Color.ElevatedSurface}" />
    <SolidColorBrush x:Key="SidebarBrush"
                     Color="{StaticResource Color.Sidebar}" />
    <SolidColorBrush x:Key="BorderBrush"
                     Color="{StaticResource Color.Border}" />
    <SolidColorBrush x:Key="TextBrush"
                     Color="{StaticResource Color.Text}" />
    <SolidColorBrush x:Key="StrongTextBrush"
                     Color="{StaticResource Color.StrongText}" />
    <SolidColorBrush x:Key="SubtleTextBrush"
                     Color="{StaticResource Color.SubtleText}" />
    <SolidColorBrush x:Key="AccentBrush"
                     Color="{StaticResource Color.Accent}" />
    <SolidColorBrush x:Key="AccentHoverBrush"
                     Color="{StaticResource Color.AccentHover}" />
    <SolidColorBrush x:Key="AccentPressedBrush"
                     Color="{StaticResource Color.AccentPressed}" />
    <SolidColorBrush x:Key="OnAccentBrush"
                     Color="{StaticResource Color.OnAccent}" />
    <SolidColorBrush x:Key="SelectionBrush"
                     Color="{StaticResource Color.Selection}" />
    <SolidColorBrush x:Key="DisabledTextBrush"
                     Color="{StaticResource Color.DisabledText}" />
    <SolidColorBrush x:Key="DisabledSurfaceBrush"
                     Color="{StaticResource Color.DisabledSurface}" />
    <SolidColorBrush x:Key="DangerBrush"
                     Color="{StaticResource Color.Danger}" />
</ResourceDictionary>
